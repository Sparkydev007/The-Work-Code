# The Work Code - environment template
# Copy to .env (docker compose) or export in your shell for local runs.

# ---- Database (Neon/Supabase or local Postgres) ----
# Neon example: postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/workcode?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workcode
SPRING_DATASOURCE_USERNAME=workcode
SPRING_DATASOURCE_PASSWORD=workcode

# ---- Security ----
# MUST be at least 32 chars for HS256. Change for any shared deployment.
JWT_SECRET=demo-secret-key-change-me-0123456789abcdef

# ---- Demo flags ----
DEMO_MODE=true
SEED_DEMO_DATA=true

# ---- Gateway service targets (docker compose already sets these) ----
# GATEWAY_IDENTITY_TARGET=http://identity-service:8081
# GATEWAY_EMPLOYEE_TARGET=http://employee-service:8082
# GATEWAY_EMPLOYER_TARGET=http://employer-service:8083
# GATEWAY_EMPLOYMENT_TARGET=http://employment-service:8084
# GATEWAY_INCOME_TARGET=http://income-service:8085
# GATEWAY_VERIFICATION_TARGET=http://verification-service:8086
# GATEWAY_RISK_TARGET=http://risk-service:8087
# GATEWAY_REPORT_TARGET=http://report-service:8088
# GATEWAY_AUDIT_TARGET=http://audit-service:8089
# GATEWAY_BATCH_TARGET=http://batch-service:8090
# GATEWAY_NOTIFICATION_TARGET=http://notification-service:8091

# ---- Frontend ----
# Where the browser-resident API client should send requests (defaults to :8080)
TWC_API_BASE=http://localhost:8080
TWC_USE_DEMO_DATA=true
